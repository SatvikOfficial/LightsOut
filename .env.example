# LIGHTS OUT server configuration
PORT=8787

# Comma-separated WebSocket origin allowlist, e.g. https://play.example.com
# Leave empty for local/LAN development.
ORIGINS=

# Enables the debug message handler. Never enable on a public server.
LIGHTS_OUT_DEBUG=0

MAX_HUMANS=12
HEARTBEAT_MS=15000
AFK_MS=60000
MAX_CONNECTIONS_PER_IP=3
